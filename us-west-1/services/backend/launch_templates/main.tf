provider "aws" {
  region = "us-west-1"
}

data "aws_security_group" "AWS-PRAC-SEC" {
  filter {
    name   = "tag:Name"
    values = ["AWS-PRAC-SEC"]
  }
}

resource "aws_launch_template" "launch_template" {
  name          = "default-template"
  image_id      = "ami-075b24c34725edbe7"
  instance_type = "t2.micro"
  vpc_security_group_ids = [data.aws_security_group.AWS-PRAC-SEC.id]
  key_name = "AWS-REACT"
  user_data = ""
  block_device_mappings {
    device_name = "/dev/sdf"
    ebs {
      volume_size = 16
      volume_type = "gp2"
    }
  }
  tags = {
    Name = "default-template"
  }

}